#!/usr/bin/env bash
#ddev-generated
## Description: Tail the WireMock container logs
## Usage: wiremock-logs [flags]
## Example: "ddev wiremock-logs -f" or "ddev wiremock-logs --tail 100"

set -euo pipefail

for arg in "$@"; do
  if [ "$arg" = "-h" ] || [ "$arg" = "--help" ]; then
    sed -n 's/^## //p' "$0"
    exit 0
  fi
done

exec ddev logs -s wiremock "$@"
