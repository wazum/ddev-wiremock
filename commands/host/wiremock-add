#!/usr/bin/env bash
#ddev-generated
## Description: Scaffold a new stub JSON file under .ddev/wiremock/mappings/
## Usage: wiremock-add <METHOD> <PATH> [--status N] [--body JSON|@FILE|-] [--content-type TYPE] [--delay MS] [--force]
## Example: "ddev wiremock-add GET /users/42"
## Example: "ddev wiremock-add POST /users --status 201"
## Example: "ddev wiremock-add GET /users/42 --body '{\"id\":42,\"name\":\"Alice\"}'"
## Example: "ddev wiremock-add GET /users/42 --body @response.json"
## Example: "curl -s https://api.example.com/users/42 | ddev wiremock-add GET /users/42 --body -"
## Example: "ddev wiremock-add GET /missing --status 404 --body '{\"error\":\"not found\"}'"
## Example: "ddev wiremock-add GET /slow --delay 3000" (to test client timeouts)
##
## Writes an exact-match stub. For regex paths or advanced features edit
## the JSON file afterwards; see https://wiremock.org/docs/stubbing/.
## Run 'ddev wiremock-reload' afterwards so the service picks it up.

set -euo pipefail

status=200
body=""
content_type="application/json"
delay=""
force=false
method=""
url_path=""

while [ $# -gt 0 ]; do
  case "$1" in
    --status)
      shift
      status="${1:-}"
      if ! [[ "$status" =~ ^[1-5][0-9]{2}$ ]]; then
        echo "error: --status requires an HTTP status code (100-599)." >&2
        exit 2
      fi
      ;;
    --body)
      if [ $# -lt 2 ]; then
        echo "error: --body requires a JSON argument." >&2
        exit 2
      fi
      shift
      body="$1"
      ;;
    --content-type)
      shift
      content_type="${1:-}"
      if [ -z "$content_type" ]; then
        echo "error: --content-type requires a value." >&2
        exit 2
      fi
      ;;
    --delay)
      shift
      delay="${1:-}"
      if ! [[ "$delay" =~ ^[0-9]+$ ]]; then
        echo "error: --delay requires a whole number of milliseconds." >&2
        exit 2
      fi
      ;;
    --force)
      force=true
      ;;
    -h|--help)
      sed -n 's/^## //p' "$0"
      exit 0
      ;;
    -*)
      echo "error: unknown option: $1" >&2
      echo "Try: ddev wiremock-add --help" >&2
      exit 2
      ;;
    *)
      if [ -z "$method" ]; then
        method="$1"
      elif [ -z "$url_path" ]; then
        url_path="$1"
      else
        echo "error: unexpected argument: $1" >&2
        echo "Usage: ddev wiremock-add <METHOD> <PATH> [options]" >&2
        exit 2
      fi
      ;;
  esac
  shift
done

case "$body" in
  @*)
    body_file="${body#@}"
    if [ ! -f "$body_file" ]; then
      echo "error: --body file not found: $body_file" >&2
      exit 2
    fi
    body=$(cat "$body_file")
    ;;
  -)
    body=$(cat)
    ;;
esac

# Paths above here are the caller's, below here the project's.
cd "${DDEV_APPROOT:-.}"

if [ -z "$method" ] || [ -z "$url_path" ]; then
  echo "error: METHOD and PATH are required." >&2
  echo "Usage: ddev wiremock-add <METHOD> <PATH> [options]" >&2
  exit 2
fi

method_upper=$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')
case "$method_upper" in
  GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|ANY) ;;
  *)
    echo "error: unsupported method: $method" >&2
    echo "Supported: GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS, ANY." >&2
    exit 2
    ;;
esac

case "$url_path" in
  /*) ;;
  *)
    echo "error: PATH must start with '/'. Got: $url_path" >&2
    exit 2
    ;;
esac

case "${url_path}${content_type}" in
  *'"'*|*\\*)
    echo "error: PATH and --content-type must not contain double quotes or backslashes." >&2
    exit 2
    ;;
esac

method_lower=$(printf '%s' "$method_upper" | tr '[:upper:]' '[:lower:]')
path_slug=$(printf '%s' "${url_path#/}" | sed -e 's/[^a-zA-Z0-9._-]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//')
if [ -z "$path_slug" ]; then
  path_slug="root"
fi
filename="${method_lower}-${path_slug}.json"
target=".ddev/wiremock/mappings/${filename}"

if [ ! -d ".ddev/wiremock/mappings" ]; then
  echo "error: .ddev/wiremock/mappings/ not found. Is the add-on installed?" >&2
  exit 1
fi

if [ -f "$target" ] && [ "$force" != true ]; then
  echo "error: stub already exists: $target" >&2
  echo "Use --force to overwrite, or pick a different path." >&2
  exit 1
fi

# urlPath ignores the query string, url matches path and query together.
case "$url_path" in
  *\?*) match_field="url" ;;
  *) match_field="urlPath" ;;
esac

if [ -z "$body" ]; then
  body_value="{}"
else
  # The body is kept as given, not reformatted.
  body_value=$(printf '%s' "$body" | sed '2,$s/^/    /')
fi

delay_line=""
if [ -n "$delay" ]; then
  delay_line=$'\n    "fixedDelayMilliseconds": '"${delay},"
fi

stub=$(cat <<JSON
{
  "request": {
    "method": "${method_upper}",
    "${match_field}": "${url_path}"
  },
  "response": {
    "status": ${status},
    "headers": {
      "Content-Type": "${content_type}"
    },${delay_line}
    "jsonBody": ${body_value}
  }
}
JSON
)

# jq runs in the web container so the host needs no JSON tooling.
check=$(printf '%s' "$stub" | ddev exec "jq . >/dev/null 2>&1 && echo JSON_OK || echo JSON_BAD" 2>/dev/null) || check=""

case "$check" in
  *JSON_BAD*)
    echo "error: --body must be valid JSON." >&2
    echo "Got: $body" >&2
    exit 2
    ;;
  *JSON_OK*) ;;
  *)
    echo "note: could not reach the project, skipped JSON validation." >&2
    ;;
esac

printf '%s\n' "$stub" > "$target"

echo "Wrote ${target}"
echo "Run 'ddev wiremock-reload' to activate the stub."
