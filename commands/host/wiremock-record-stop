#!/usr/bin/env bash
#ddev-generated
## Description: Stop recording and persist captured stubs
## Usage: wiremock-record-stop
## Example: "ddev wiremock-record-stop"
##
## New stub JSON files appear under .ddev/wiremock/mappings/. Review them
## with 'git diff' before committing.

set -euo pipefail

for arg in "$@"; do
  if [ "$arg" = "-h" ] || [ "$arg" = "--help" ]; then
    sed -n 's/^## //p' "$0"
    exit 0
  fi
done

if [ $# -gt 0 ]; then
  echo "error: unexpected argument: $1" >&2
  echo "Usage: ddev wiremock-record-stop" >&2
  exit 2
fi

if ! count=$(ddev exec "curl -fsS -X POST http://wiremock:8080/__admin/recordings/stop | jq '.mappings | length'" 2>&1); then
  echo "error: WireMock not reachable or stop failed." >&2
  echo "Check 'ddev describe' and 'ddev wiremock-logs'." >&2
  exit 1
fi

echo "Recording stopped. ${count} stubs written to .ddev/wiremock/mappings/."
echo "Review 'git diff .ddev/wiremock/mappings/' before committing."
